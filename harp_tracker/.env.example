# Copy to .env in this folder (harp_tracker/) before building or running.

# --- WebRTC TURN (required when handshake stalls across NAT / different networks) ---
# Comma-separated. Include both UDP and TLS variants if your provider offers them.
TURN_URLS=turn:your-turn.example.com:3478, turns:your-turn.example.com:5349
TURN_USERNAME=your_turn_user
TURN_CREDENTIAL=your_turn_password
# Set to true to only use TURN relay candidates (stricter NATs)
TURN_FORCE_RELAY=false

# Optional extra STUN servers (comma-separated)
# STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# --- Other HARP Tracker keys ---
# STADIAMAPS_API_KEY=
# APRSFI_API_KEY=
